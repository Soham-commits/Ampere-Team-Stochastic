# Copy to .env (never commit it) or export these in your shell.

# Postgres connection
DATABASE_URL=postgres://localhost:5432/ampere

# HMAC secret for session tokens. Without it, a random secret is used and sessions end on restart.
TOKEN_SECRET=

# Comma-separated origins allowed to call the API from another origin
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

PORT=8787
